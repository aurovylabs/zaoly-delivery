# Zaoly delivery env — copy to .env (never commit filled values).
# Profile B · Self-host via delivery pack (no product source tree).
# Product docs: knowledge/self-host.md · knowledge/zaoly-delivery-repo.md

# Public origin (Auth.js + absolute links)
NEXT_PUBLIC_ZAOLY_URL=https://zaoly.example.com
AUTH_URL=https://zaoly.example.com
ZAOLY_STANDALONE=1
PORT=3000
# ZAOLY_HOST_PORT=3000
ZAOLY_EDITOR_INAPP=1

# Container image (defaults in compose: zaoly:latest)
# ZAOLY_IMAGE=zaoly:latest
# ZAOLY_IMAGE_TAG=latest

# Required secrets
AUTH_SECRET=
ZAOLY_POSTGRES_PASSWORD=
ZAOLY_DATABASE_URL=postgresql://zaoly:replace-me@zaoly-postgres:5432/zaoly
ZAOLY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ZAOLY_BOOTSTRAP_ADMIN_PASSWORD=

# Optional Google OAuth — redirect: {AUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# ZAOLY_PUBLIC_SIGNUP=0
# ZAOLY_PLATFORM_ADMIN_EMAILS=admin@example.com
# ZAOLY_PLATFORM_ADMIN_IMPERSONATION=1

# System mail — do NOT set ZAOLY_SMTP_MANAGED on self-host
# ZAOLY_SMTP_HOST=
# ZAOLY_SMTP_PORT=587
# ZAOLY_SMTP_USER=
# ZAOLY_SMTP_PASS=
# ZAOLY_SMTP_FROM=noreply@example.com
# ZAOLY_SMTP_FROM_NAME=Zaoly
# ZAOLY_SMTP_TLS=starttls
